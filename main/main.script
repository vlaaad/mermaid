go.property("solar_flux",resource.texture("/assets/generated/sunlight_aperture.png"))
local obstacles = require "main.obstacles"
local collision = require "main.collision"
local life = require "main.life"
local currents = require "main.currents"
local function clamp(v,a,b) return math.max(a,math.min(b,v)) end
local function smooth(rate,dt) return 1-math.exp(-rate*dt) end
local function wrap(a) return (a+math.pi)%(math.pi*2)-math.pi end

local function reset(self,freeze)
    window.set_mouse_lock(false)
    self.position=vmath.vector3(-1,4.8,4)
    self.velocity=vmath.vector3()
    self.yaw=0
    self.pitch=-.04
    self.heading=-.22
    self.camera=vmath.vector3(0,7,13)
    self.time=3
    self.frozen=freeze or false
    self.keys={}
    self.taps={}
    self.pose_speed=0
    self.speed=0
    self.bank=0
    self.tilt=-.45
    self.dragging=false
    self.steering=false
    self.edge_yaw=0
    self.edge_pitch=0
    self.mouse_frame=-1
    self.mouse_was_locked=false
    self.mouse_ready_frame=0
    self.camera_cache=nil
    self.body_cache=nil
    self.inspect_camera=nil
    self.started=false
    if self.life then life.reset(self.life,self.time) end
end

local function camera_obstruction(anchor,arm,b)
    local low,high=0,1
    local function slab(origin,delta,center,extent)
        if math.abs(delta)<.00001 then return math.abs(origin-center)<=extent end
        local a=(center-extent-origin)/delta
        local c=(center+extent-origin)/delta
        low=math.max(low,math.min(a,c))
        high=math.min(high,math.max(a,c))
        return low<=high
    end
    if not slab(anchor.x,arm.x,b[1],b[4]+.25) then return nil end
    if not slab(anchor.y,arm.y,b[2],b[5]+.25) then return nil end
    if not slab(anchor.z,arm.z,b[3],b[6]+.25) then return nil end
    if b[7] then
        for _,plane in ipairs(b[7]) do
            local distance=anchor.x*plane[1]+anchor.y*plane[2]+anchor.z*plane[3]-plane[4]-.25
            local direction=arm.x*plane[1]+arm.y*plane[2]+arm.z*plane[3]
            if math.abs(direction)<.000001 then
                if distance>0 then return nil end
            elseif direction<0 then low=math.max(low,-distance/direction)
            else high=math.min(high,-distance/direction) end
            if low>high then return nil end
        end
    end
    return low
end

local function state(self)
    return {ready=self.frames>30,frozen=self.frozen,time=self.time,speed=self.speed,position={x=self.position.x,y=self.position.y,z=self.position.z},camera={x=self.camera.x,y=self.camera.y,z=self.camera.z},yaw=self.yaw,pitch=self.pitch,tilt=self.tilt,heading=self.heading,steering=self.steering or window.get_mouse_lock(),captured=window.get_mouse_lock(),depth=50-self.position.y,frames=self.frames,frame_ms=self.frame_ms,last_input=self.last_input or "none"}
end

function init(self)
    msg.post("@render:","solar_flux",{texture=resource.get_texture_info(self.solar_flux).handle})
    msg.post(".","acquire_input_focus")
    reset(self,false)
    self.life=life.new()
    life.reset(self.life,self.time)
    self.frames=0
    self.publish_timer=0
    self.frame_ms=0
    if html5 then
        self.frozen=html5.run("String(new URLSearchParams(location.search).has('capture'))")=="true"
    end
    if automation_bridge then
        automation_bridge.command("mermaid.reset",function(data) reset(self,data.freeze~=false) return state(self) end)
        automation_bridge.command("mermaid.capture",function(data)
            reset(self,true)
            self.pose_speed=tonumber(data.swim_speed) or 0
            if data.position then self.position=vmath.vector3(data.position.x,data.position.y,data.position.z) end
            if data.time then self.time=data.time;life.reset(self.life,self.time) end
            if data.yaw then self.yaw=data.yaw end
            if data.pitch then self.pitch=clamp(data.pitch,-1.48,1.48) end
            if data.camera and data.look then self.inspect_camera=data end
            return state(self)
        end)
        automation_bridge.command("mermaid.lighting",function(data) msg.post("@render:","lighting_debug",{mode=tonumber(data.mode) or 0,static_only=data.static_only or false}) return {mode=data.mode or 0} end)
        automation_bridge.command("mermaid.resume",function() self.frozen=false return state(self) end)
        automation_bridge.command("mermaid.life",function() return life.state(self.life) end)
        automation_bridge.command("mermaid.floor",function(data)
            local h,nx,ny,nz=collision.floor_height(data.x,data.z)
            return {height=h,normal={x=nx,y=ny,z=nz}}
        end)
        automation_bridge.describe("command","mermaid.capture",{description="Reset opening camera, player pose, seed-dependent scene, and animation time; freeze until input or resume."})
    end
    window.set_listener(function(_,event)
        if event==window.WINDOW_EVENT_FOCUS_LOST then
            window.set_mouse_lock(false);self.dragging=false;self.steering=false;self.keys={};self.taps={}
        end
    end)
    print("MERMAID_READY seed=73; click to steer; mouse aim; W swim; S reverse; Shift boost; Tab release; A/D strafe; Space/Q rise/dive; R reset")
end

function update(self,dt)
    local raw_dt=dt
    dt=math.min(dt,.1)
    self.frames=self.frames+1
    self.frame_ms=self.frame_ms+(raw_dt*1000-self.frame_ms)*.06
    local k=self.keys
    local function down(key) local id=hash(key) return (k[id] or (self.taps[id] or 0)>0) and 1 or 0 end
    local forward=down("forward")-down("back")
    -- Embedded browsers may refuse pointer lock. Keep relative mouse aiming,
    -- and allow unlimited turns by holding the cursor near an edge while
    -- thrusting. The normal captured mouse path never uses edge steering.
    if self.steering and not window.get_mouse_lock() and forward~=0 then
        self.yaw=self.yaw+self.edge_yaw*dt
        self.pitch=clamp(self.pitch+self.edge_pitch*dt,-1.48,1.48)
    end
    local side=down("right")-down("left")
    local vertical=math.max(down("rise"),down("rise_alt"))-math.max(down("dive"),down("dive_alt"))
    local aim=vmath.vector3(-math.sin(self.yaw)*math.cos(self.pitch),math.sin(self.pitch),-math.cos(self.yaw)*math.cos(self.pitch))
    local desired=aim*forward+vmath.vector3(side*math.cos(self.yaw),vertical,-side*math.sin(self.yaw))
    if vmath.length_sqr(desired)>0 then
        desired=vmath.normalize(desired)
        self.frozen=false
        self.started=true
    end
    local target_speed=down("boost")==1 and 8.4 or 4.4
    local input=vmath.length_sqr(desired)>0
    self.velocity=vmath.lerp(smooth(input and 4.5 or 3.4,dt),self.velocity,desired*target_speed)
    if vmath.length_sqr(self.velocity)<.0001 then self.velocity=vmath.vector3() end
    self.speed=self.frozen and self.pose_speed or vmath.length(self.velocity)
    if input and math.abs(desired.x)+math.abs(desired.z)>.00001 then
        local target_heading=forward<0 and self.yaw or math.atan2(-desired.x,-desired.z)
        self.heading=self.heading+wrap(target_heading-self.heading)*smooth(6,dt)
    end
    local swimming=math.min(self.speed/2,1)
    local vertical_aim=self.pitch
    if input and forward>=0 then vertical_aim=math.atan2(desired.y,math.sqrt(desired.x*desired.x+desired.z*desired.z)) end
    -- Her curved authored pose already leans the head-to-fin axis forward by
    -- about .46 radians. Account for that when aligning the rigid model.
    local target_tilt=-.45*(1-swimming)+(vertical_aim-math.pi*.5+.46)*swimming
    self.tilt=self.frozen and target_tilt or self.tilt+(target_tilt-self.tilt)*smooth(4.5,dt)
    self.bank=self.bank+(side*-.16-self.bank)*smooth(4,dt)
    -- Resolve the whole newly rotated body, even when steering beside a rock
    -- without translating. Turning cannot rotate the head or fin into stone.
    local cached=self.body_cache
    local changed=not cached or math.abs(cached.heading-self.heading)> .00001 or math.abs(cached.tilt-self.tilt)> .00001 or math.abs(cached.bank-self.bank)> .00001
    if changed then
        local rotation=vmath.quat_rotation_y(self.heading)*vmath.quat_rotation_z(self.bank-.12)*vmath.quat_rotation_x(self.tilt)
        cached={body=collision.body(rotation),heading=self.heading,tilt=self.tilt,bank=self.bank}
        self.body_cache=cached
    end
    local drift=vmath.vector3()
    if not self.frozen then
        local x,y,z=currents.sample(self.position.x,self.position.y,self.position.z,self.time)
        drift=vmath.vector3(x,y,z)
    end
    if changed or self.speed>0 or not self.frozen then
        local steps=math.max(1,math.ceil(dt/.025))
        for _=1,steps do self.position=collision.resolve(self.position+(self.velocity+drift)*(dt/steps),cached.body) end
    end
    if not self.frozen then self.time=self.time+dt end
    local bank,tilt=self.bank,self.tilt
    go.set_position(self.position,"/player")
    go.set_rotation(vmath.quat_rotation_y(self.heading)*vmath.quat_rotation_z(bank-.12)*vmath.quat_rotation_x(tilt),"/player")
    go.set_scale(.85,"/player")
    local rotation=vmath.quat_rotation_y(self.heading)*vmath.quat_rotation_z(bank-.12)*vmath.quat_rotation_x(tilt)
    life.update(self.life,dt,self.time,self.position,rotation,self.speed,cached.body,self.frozen)
    local offset=vmath.vector3(math.sin(self.yaw)*9*math.cos(self.pitch),1.36-math.sin(self.pitch)*9,math.cos(self.yaw)*9*math.cos(self.pitch))
    local desired_camera=self.position+offset+vmath.vector3(.6,0,0)
    desired_camera.y=math.min(49,desired_camera.y)
    -- Broad phase plus an exact expanded-AABB segment test. Cache stationary arms.
    local anchor=self.position+vmath.vector3(0,1,0)
    local arm=desired_camera-anchor
    -- Terrain and stone both obstruct the camera. Retract the arm at the first
    -- crossing instead of pinning every underwater camera above the old floor.
    for i=1,16 do
        local point=anchor+arm*(i/16)
        if point.y<collision.floor_height(point.x,point.z)+.35 then
            arm=arm*math.max(.08,(i-1)/16);desired_camera=anchor+arm;break
        end
    end
    local cache=self.camera_cache
    if cache and cache.yaw==self.yaw and cache.pitch==self.pitch and vmath.length_sqr(cache.position-self.position)<.000001 then
        desired_camera=cache.camera
    else
        local minx,maxx=math.min(anchor.x,desired_camera.x),math.max(anchor.x,desired_camera.x)
        local miny,maxy=math.min(anchor.y,desired_camera.y),math.max(anchor.y,desired_camera.y)
        local minz,maxz=math.min(anchor.z,desired_camera.z),math.max(anchor.z,desired_camera.z)
        local nearest=1
        for _,b in ipairs(obstacles) do
            if b[1]+b[4]+.25>=minx and b[1]-b[4]-.25<=maxx and b[2]+b[5]+.25>=miny and b[2]-b[5]-.25<=maxy and b[3]+b[6]+.25>=minz and b[3]-b[6]-.25<=maxz then
                local hit=camera_obstruction(anchor,arm,b)
                if hit then nearest=math.min(nearest,math.max(.12,hit-.04)) end
            end
        end
        desired_camera=anchor+arm*nearest
        self.camera_cache={position=self.position,yaw=self.yaw,pitch=self.pitch,camera=desired_camera}
    end
    self.camera=self.frozen and desired_camera or vmath.lerp(smooth(5,dt),self.camera,desired_camera)
    local look=self.position+vmath.vector3(.65,1.1,0)+aim*16
    if self.inspect_camera and self.frozen then
        local c,l=self.inspect_camera.camera,self.inspect_camera.look
        self.camera=vmath.vector3(c.x,c.y,c.z)
        look=vmath.vector3(l.x,l.y,l.z)
    end
    local view=vmath.matrix4_look_at(self.camera,look,vmath.vector3(0,1,0))
    msg.post("@render:","scene_camera",{view=view,shadow_focus=self.position,position=vmath.vector4(self.camera.x,self.camera.y,self.camera.z,1),time_data=vmath.vector4(self.time,self.speed,0,0)})
    self.publish_timer=self.publish_timer+dt
    if self.publish_timer>=.2 then
        self.publish_timer=0
        if automation_bridge then automation_bridge.publish("mermaid",state(self)) end
        if html5 then
            html5.run("window.mermaidState="..json.encode(state(self)))
        end
    end
    for id,remaining in pairs(self.taps) do
        if remaining<=dt then self.taps[id]=nil else self.taps[id]=remaining-dt end
    end
end

function on_input(self,id,action)
    local locked=window.get_mouse_lock()
    if locked~=self.mouse_was_locked then
        if not locked and self.mouse_was_locked then self.steering=false end
        self.mouse_was_locked=locked
        -- Discard the cursor warp when entering/leaving relative steering.
        self.mouse_ready_frame=self.frames+2
    end
    if id==hash("release_mouse") and action.pressed then
        window.set_mouse_lock(false);self.dragging=false;self.steering=false;self.edge_yaw=0;self.edge_pitch=0
    end
    if id==hash("touch") or id==hash("look") then
        if action.pressed then
            self.dragging=true
            self.mouse_frame=self.frames
            if id==hash("touch") then self.steering=true;window.set_mouse_lock(true) end
        end
        if action.released then self.dragging=false end
    end
    if self.steering and action.x and action.y then
        local function edge(v)
            local amount=math.max(0,(math.abs(v)-.86)/.14)
            return math.min(amount,1)*(v<0 and -1 or 1)
        end
        self.edge_yaw=-edge(action.x/1280*2-1)*.85
        self.edge_pitch=edge(action.y/720*2-1)*.85
    end
    if (self.steering or window.get_mouse_lock() or self.dragging) and self.frames>=self.mouse_ready_frame and not action.pressed and self.mouse_frame~=self.frames and action.dx and (action.dx~=0 or action.dy~=0) then
        -- Button and motion bindings may carry the same delta in one frame.
        self.mouse_frame=self.frames
        self.yaw=self.yaw-action.dx*.0032
        self.pitch=clamp(self.pitch+action.dy*.003,-1.48,1.48)
        self.frozen=false;self.started=true
    end
    if id==hash("reset") and action.pressed then reset(self,false) end
    if id then
        if action.pressed then self.last_input=tostring(id) end
        if action.pressed then self.keys[id]=true self.taps[id]=.08 end
        if action.released then self.keys[id]=false end
    end
end
