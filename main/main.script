go.property("surface_flux", resource.texture("/assets/generated/caustics.png"))
local obstacles = require "main.obstacles"
local collision = require "main.collision"
local function clamp(v,a,b) return math.max(a,math.min(b,v)) end
local function smooth(rate,dt) return 1-math.exp(-rate*dt) end
local function wrap(a) return (a+math.pi)%(math.pi*2)-math.pi end

local function reset(self,freeze)
    self.position=vmath.vector3(-1,4.8,4)
    self.velocity=vmath.vector3()
    self.yaw=0
    self.pitch=-.04
    self.heading=-.22
    self.camera=vmath.vector3(0,7,13)
    self.time=3
    self.frozen=freeze or false
    self.keys={}
    self.taps={}
    self.speed=0
    self.bank=0
    self.tilt=-.45
    self.dragging=false
    self.camera_cache=nil
    self.inspect_camera=nil
end

local function camera_obstruction(anchor,arm,b)
    local low,high=0,1
    local function slab(origin,delta,center,extent)
        if math.abs(delta)<.00001 then return math.abs(origin-center)<=extent end
        local a=(center-extent-origin)/delta
        local c=(center+extent-origin)/delta
        low=math.max(low,math.min(a,c))
        high=math.min(high,math.max(a,c))
        return low<=high
    end
    if not slab(anchor.x,arm.x,b[1],b[4]+.25) then return nil end
    if not slab(anchor.y,arm.y,b[2],b[5]+.25) then return nil end
    if not slab(anchor.z,arm.z,b[3],b[6]+.25) then return nil end
    if b[7] then
        for _,plane in ipairs(b[7]) do
            local distance=anchor.x*plane[1]+anchor.y*plane[2]+anchor.z*plane[3]-plane[4]-.25
            local direction=arm.x*plane[1]+arm.y*plane[2]+arm.z*plane[3]
            if math.abs(direction)<.000001 then
                if distance>0 then return nil end
            elseif direction<0 then low=math.max(low,-distance/direction)
            else high=math.min(high,-distance/direction) end
            if low>high then return nil end
        end
    end
    return low
end

local function state(self)
    return {ready=self.frames>30,frozen=self.frozen,time=self.time,speed=self.speed,position={x=self.position.x,y=self.position.y,z=self.position.z},camera={x=self.camera.x,y=self.camera.y,z=self.camera.z},yaw=self.yaw,pitch=self.pitch,frames=self.frames,frame_ms=self.frame_ms,last_input=self.last_input or "none"}
end

function init(self)
    msg.post("@render:","surface_flux",{texture=resource.get_texture_info(self.surface_flux).handle})
    msg.post(".","acquire_input_focus")
    reset(self,false)
    self.frames=0
    self.publish_timer=0
    self.frame_ms=0
    if html5 then
        self.frozen=html5.run("String(new URLSearchParams(location.search).has('capture'))")=="true"
    end
    if automation_bridge then
        automation_bridge.command("mermaid.reset",function(data) reset(self,data.freeze~=false) return state(self) end)
        automation_bridge.command("mermaid.capture",function(data)
            reset(self,true)
            if data.position then self.position=vmath.vector3(data.position.x,data.position.y,data.position.z) end
            if data.time then self.time=data.time end
            if data.camera and data.look then self.inspect_camera=data end
            return state(self)
        end)
        automation_bridge.command("mermaid.lighting",function(data) msg.post("@render:","lighting_debug",{mode=tonumber(data.mode) or 0}) return {mode=data.mode or 0} end)
        automation_bridge.command("mermaid.resume",function() self.frozen=false return state(self) end)
        automation_bridge.describe("command","mermaid.capture",{description="Reset opening camera, player pose, seed-dependent scene, and animation time; freeze until input or resume."})
    end
    print("MERMAID_READY seed=73; WASD swim; Space/E rise; Ctrl/Q dive; Shift boost; drag mouse orbit; R reset; P profiler")
end

function update(self,dt)
    local raw_dt=dt
    dt=math.min(dt,.1)
    self.frames=self.frames+1
    self.frame_ms=self.frame_ms+(raw_dt*1000-self.frame_ms)*.06
    local k=self.keys
    local function down(key) local id=hash(key) return (k[id] or (self.taps[id] or 0)>0) and 1 or 0 end
    local forward=down("forward")-down("back")
    local side=down("right")-down("left")
    local vertical=math.max(down("rise"),down("rise_alt"))-math.max(down("dive"),down("dive_alt"))
    local desired=vmath.vector3(side*math.cos(self.yaw)-forward*math.sin(self.yaw),vertical,-forward*math.cos(self.yaw)-side*math.sin(self.yaw))
    if vmath.length_sqr(desired)>0 then
        desired=vmath.normalize(desired)
        self.frozen=false
        self.started=true
    end
    local target_speed=down("boost")==1 and 8.4 or 4.4
    local input=vmath.length_sqr(desired)>0
    self.velocity=vmath.lerp(smooth(input and 4.5 or 3.4,dt),self.velocity,desired*target_speed)
    if vmath.length_sqr(self.velocity)>.0001 then
        local steps=math.max(1,math.ceil(dt/.025))
        local rotation=vmath.quat_rotation_y(self.heading)*vmath.quat_rotation_z(self.bank-.12)*vmath.quat_rotation_x(self.tilt)
        local body=collision.body(rotation)
        for _=1,steps do self.position=collision.resolve(self.position+self.velocity*(dt/steps),body) end
    else self.velocity=vmath.vector3() end
    self.speed=vmath.length(self.velocity)
    if input and (forward~=0 or side~=0) then
        local target_heading=math.atan2(-desired.x,-desired.z)
        self.heading=self.heading+wrap(target_heading-self.heading)*smooth(6,dt)
    end
    if not self.frozen then self.time=self.time+dt end
    self.bank=self.bank+(side*-.16-self.bank)*smooth(4,dt)
    self.tilt=self.tilt+(-.45+forward*.08-vertical*.14-self.tilt)*smooth(4,dt)
    local bank,tilt=self.bank,self.tilt
    go.set_position(self.position,"/player")
    go.set_rotation(vmath.quat_rotation_y(self.heading)*vmath.quat_rotation_z(bank-.12)*vmath.quat_rotation_x(tilt),"/player")
    go.set_scale(.85,"/player")
    local offset=vmath.vector3(math.sin(self.yaw)*9*math.cos(self.pitch),1.36-math.sin(self.pitch)*9,math.cos(self.yaw)*9*math.cos(self.pitch))
    local desired_camera=self.position+offset+vmath.vector3(.6,0,0)
    desired_camera.y=math.max(.8,desired_camera.y)
    -- Broad phase plus an exact expanded-AABB segment test. Cache stationary arms.
    local anchor=self.position+vmath.vector3(0,1,0)
    local arm=desired_camera-anchor
    local cache=self.camera_cache
    if cache and cache.yaw==self.yaw and cache.pitch==self.pitch and vmath.length_sqr(cache.position-self.position)<.000001 then
        desired_camera=cache.camera
    else
        local minx,maxx=math.min(anchor.x,desired_camera.x),math.max(anchor.x,desired_camera.x)
        local miny,maxy=math.min(anchor.y,desired_camera.y),math.max(anchor.y,desired_camera.y)
        local minz,maxz=math.min(anchor.z,desired_camera.z),math.max(anchor.z,desired_camera.z)
        local nearest=1
        for _,b in ipairs(obstacles) do
            if b[1]+b[4]+.25>=minx and b[1]-b[4]-.25<=maxx and b[2]+b[5]+.25>=miny and b[2]-b[5]-.25<=maxy and b[3]+b[6]+.25>=minz and b[3]-b[6]-.25<=maxz then
                local hit=camera_obstruction(anchor,arm,b)
                if hit then nearest=math.min(nearest,math.max(.12,hit-.04)) end
            end
        end
        desired_camera=anchor+arm*nearest
        self.camera_cache={position=self.position,yaw=self.yaw,pitch=self.pitch,camera=desired_camera}
    end
    self.camera=self.frozen and desired_camera or vmath.lerp(smooth(5,dt),self.camera,desired_camera)
    local look=self.position+vmath.vector3(.65,1.1,0)+vmath.vector3(-math.sin(self.yaw)*16,math.sin(self.pitch)*16,-math.cos(self.yaw)*16)
    if self.inspect_camera and self.frozen then
        local c,l=self.inspect_camera.camera,self.inspect_camera.look
        self.camera=vmath.vector3(c.x,c.y,c.z)
        look=vmath.vector3(l.x,l.y,l.z)
    end
    local view=vmath.matrix4_look_at(self.camera,look,vmath.vector3(0,1,0))
    msg.post("@render:","scene_camera",{view=view,shadow_focus=self.position,position=vmath.vector4(self.camera.x,self.camera.y,self.camera.z,1),time_data=vmath.vector4(self.time,self.speed,0,0)})
    self.publish_timer=self.publish_timer+dt
    if self.publish_timer>=.2 then
        self.publish_timer=0
        if automation_bridge then automation_bridge.publish("mermaid",state(self)) end
        if html5 then
            html5.run("window.mermaidState="..json.encode(state(self)))
        end
    end
    for id,remaining in pairs(self.taps) do
        if remaining<=dt then self.taps[id]=nil else self.taps[id]=remaining-dt end
    end
end

function on_input(self,id,action)
    if id==hash("touch") or id==hash("look") then
        if action.pressed then self.dragging=true end
        if action.released then self.dragging=false end
    end
    if self.dragging and action.dx and (action.dx~=0 or action.dy~=0) then
        self.yaw=self.yaw-action.dx*.0032
        self.pitch=clamp(self.pitch+action.dy*.003,-.48,.50)
        self.frozen=false
    end
    if id==hash("reset") and action.pressed then reset(self,false) end
    if id==hash("profile") and action.pressed then
        self.show_profile=not self.show_profile
        profiler.enable_ui(self.show_profile)
    end
    if id then
        if action.pressed then self.last_input=tostring(id) end
        if action.pressed then self.keys[id]=true self.taps[id]=.08 end
        if action.released then self.keys[id]=false end
    end
end
