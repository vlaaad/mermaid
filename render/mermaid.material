name: "mermaid"
tags: "reef"
tags: "depth3"
tags: "caster3"
vertex_program: "/render/underwater.vp"
fragment_program: "/render/underwater.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants { name: "mtx_view" type: CONSTANT_TYPE_VIEW }
vertex_constants { name: "mtx_proj" type: CONSTANT_TYPE_PROJECTION }
vertex_constants { name: "time_data" type: CONSTANT_TYPE_USER value {x:3 y:0 z:0 w:0} }
vertex_constants { name: "params" type: CONSTANT_TYPE_USER value {x:3 y:0 z:0 w:0} }
fragment_constants { name: "time_data" type: CONSTANT_TYPE_USER value {x:3 y:0 z:0 w:0} }
fragment_constants { name: "params" type: CONSTANT_TYPE_USER value {x:3 y:0 z:0 w:0} }
fragment_constants { name: "fog_settings" type: CONSTANT_TYPE_USER value {x:.055 y:.43 z:.65 w:.022} }
fragment_constants { name: "camera_pos" type: CONSTANT_TYPE_USER value {x:0 y:7 z:13 w:1} }
attributes { name: "color" semantic_type: SEMANTIC_TYPE_COLOR data_type: TYPE_FLOAT vector_type: VECTOR_TYPE_VEC4 coordinate_space: COORDINATE_SPACE_LOCAL double_values { v:1 v:1 v:1 v:1 } }
samplers { name: "caustics" wrap_u: WRAP_MODE_REPEAT wrap_v: WRAP_MODE_REPEAT filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }

fragment_constants { name: "light_matrix" type: CONSTANT_TYPE_USER_MATRIX4 }
samplers { name: "sun_depth" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_NEAREST filter_mag: FILTER_MODE_MAG_NEAREST }

fragment_constants { name: "art_ambient_top" type: CONSTANT_TYPE_USER value {x:0.172800 y:0.380800 z:0.590800 w:0.480000} }
fragment_constants { name: "art_ambient_bottom" type: CONSTANT_TYPE_USER value {x:0.369200 y:0.529200 z:0.424800 w:0.000000} }
fragment_constants { name: "art_sun" type: CONSTANT_TYPE_USER value {x:0.780800 y:0.730800 z:0.530800 w:0.000000} }
fragment_constants { name: "art_fog_bottom" type: CONSTANT_TYPE_USER value {x:0.105000 y:0.416800 z:0.702000 w:0.000000} }

samplers { name: "stone_detail" wrap_u: WRAP_MODE_REPEAT wrap_v: WRAP_MODE_REPEAT filter_min: FILTER_MODE_MIN_LINEAR_MIPMAP_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
