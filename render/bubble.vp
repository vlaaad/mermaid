#version 140
in highp vec4 position;
in mediump vec2 texcoord0;
in highp mat4 mtx_world;
out mediump vec2 var_uv;
out highp float var_depth;
uniform vs_uniforms {
    highp mat4 mtx_view;
    highp mat4 mtx_proj;
    mediump vec4 time_data;
};
void main() {
    vec3 origin=mtx_world[3].xyz;
    vec4 view=mtx_view*vec4(origin,1.0);
    // A two-triangle camera-facing bubble keeps a smooth analytical silhouette.
    view.xy+=position.xy*vec2(length(mtx_world[0].xyz),length(mtx_world[1].xyz));
    var_uv=texcoord0;
    var_depth=-view.z;
    gl_Position=mtx_proj*view;
}
