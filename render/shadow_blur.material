name: "shadow_blur"
tags: "blit"
vertex_program: "/render/blit.vp"
fragment_program: "/render/shadow_blur.fp"
vertex_space: VERTEX_SPACE_LOCAL
samplers { name: "moments" wrap_u: WRAP_MODE_CLAMP_TO_EDGE wrap_v: WRAP_MODE_CLAMP_TO_EDGE filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
fragment_constants { name: "blur_direction" type: CONSTANT_TYPE_USER }
