local function target(w,h,depth_texture,format,samples)
    return render.render_target({
        sample_count=samples or 1,
        [graphics.BUFFER_TYPE_COLOR0_BIT]={format=format or graphics.TEXTURE_FORMAT_RGBA,width=w,height=h,min_filter=graphics.TEXTURE_FILTER_LINEAR,mag_filter=graphics.TEXTURE_FILTER_LINEAR,u_wrap=graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,v_wrap=graphics.TEXTURE_WRAP_CLAMP_TO_EDGE},
        [graphics.BUFFER_TYPE_DEPTH_BIT]={format=graphics.TEXTURE_FORMAT_DEPTH,width=w,height=h,flags=depth_texture and render.TEXTURE_BIT or 0,min_filter=graphics.TEXTURE_FILTER_NEAREST,mag_filter=graphics.TEXTURE_FILTER_NEAREST,u_wrap=graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,v_wrap=graphics.TEXTURE_WRAP_CLAMP_TO_EDGE}
    })
end

function init(self)
    local requested=math.max(1,sys.get_config_int("display.samples",0))
    -- This WebGL backend cannot resolve multisampled offscreen targets. Apply
    -- edge AA in the existing presentation pass instead of requesting a fallback.
    local fxaa=sys.get_sys_info().system_name=="HTML5" and requested>1
    self.scene_samples=fxaa and 1 or requested
    self.fxaa=fxaa
    self.solid=render.predicate({"reefsolid"})
    self.thin=render.predicate({"reefthin"})
    self.rigid=render.predicate({"rigid"})
    self.skinned=render.predicate({"skinned"})
    self.bubbles=render.predicate({"bubbles"})
    self.casters={}
    for _,category in ipairs({0,1,2,3,6,8}) do self.casters[category]=render.predicate({"caster"..category}) end
    self.shadow_constants=render.constant_buffer()
    self.blit=render.predicate({"blit"})
    self.view=vmath.matrix4_look_at(vmath.vector3(0,7,13),vmath.vector3(0,6,-13),vmath.vector3(0,1,0))
    self.constants=render.constant_buffer()
    self.constants.visual_debug=vmath.vector4()
    self.constants.antialias=vmath.vector4(self.fxaa and 1 or 0,0,0,0)
    print("SCENE_AA "..(self.fxaa and "FXAA" or (self.scene_samples>1 and "MSAA x"..self.scene_samples or "OFF")))
    self.constants.time_data=vmath.vector4(3,0,0,0)
    self.constants.camera_pos=vmath.vector4(0,7,13,1)
    self.constants.fog_settings=vmath.vector4(0.062500,0.625000,0.945500,.0165)
    self.shadow=target(2048,2048,true)
    self.near_shadow=target(512,512,false,graphics.TEXTURE_FORMAT_RGBA32F)
    self.near_ping=target(512,512,false,graphics.TEXTURE_FORMAT_RGBA32F)
    self.blur_constants=render.constant_buffer()
    self.shadow_focus=vmath.vector3(-1,4.8,4)
end

function update(self)
    local w,h=render.get_window_width(),render.get_window_height()
    if w==0 or h==0 then return end
    local scale=math.min(1,1280/w,720/h)
    local rw,rh=math.floor(w*scale),math.floor(h*scale)
    if not self.target then
        -- MSAA belongs on geometry, before the resolved image reaches post effects.
        self.target=target(rw,rh,self.scene_samples==1,nil,self.scene_samples)
        -- OpenGL resolves color only. Preserve a real single-sample depth texture
        -- for volume integration and silhouette-aware upsampling.
        self.scene_depth=self.scene_samples>1 and target(rw,rh,true) or self.target
        self.composite=target(rw,rh,false)
        self.rw,self.rh=rw,rh
        self.water=target(math.ceil(rw/4),math.ceil(rh/4),false,graphics.TEXTURE_FORMAT_RGBA16F)
    elseif rw~=self.rw or rh~=self.rh then
        render.set_render_target_size(self.target,rw,rh)
        if self.scene_depth~=self.target then render.set_render_target_size(self.scene_depth,rw,rh) end
        render.set_render_target_size(self.composite,rw,rh)
        render.set_render_target_size(self.water,math.ceil(rw/4),math.ceil(rh/4))
        self.rw,self.rh=rw,rh
    end
    local camera=self.constants.camera_pos
    local sun=vmath.normalize(vmath.vector3(.35,.90,-.24))
    local right=vmath.normalize(vmath.cross(-sun,vmath.vector3(0,0,1)))
    local up=vmath.normalize(vmath.cross(right,-sun))
    -- Cache only fixed stone and sand. Jointed foliage, fish and the
    -- mermaid cast through the local dynamic cascade with their current pose.
    local center=vmath.vector3(10,0,-55)
    local light_view=vmath.matrix4_look_at(center+sun*120,center,vmath.vector3(0,0,1))
    local light_proj=vmath.matrix4_orthographic(-96,96,-88,120,1,240)
    self.constants.light_matrix=light_proj*light_view
    render.set_depth_mask(true)
    render.enable_state(graphics.STATE_DEPTH_TEST)
    render.disable_state(graphics.STATE_CULL_FACE)
    render.disable_state(graphics.STATE_BLEND)
    if not self.shadow_valid then
        render.set_render_target(self.shadow)
        render.set_viewport(0,0,2048,2048)
        render.clear({[graphics.BUFFER_TYPE_COLOR0_BIT]=vmath.vector4(1),[graphics.BUFFER_TYPE_DEPTH_BIT]=1})
        render.set_view(light_view)
        render.set_projection(light_proj)
        render.enable_material("shadow")
        render.enable_state(graphics.STATE_POLYGON_OFFSET_FILL)
        render.set_polygon_offset(1,1)
        for _,category in ipairs({0,8}) do
            if category==0 or category==8 then
                render.enable_state(graphics.STATE_CULL_FACE)
                render.set_cull_face(category==0 and graphics.FACE_TYPE_FRONT or graphics.FACE_TYPE_BACK)
            else render.disable_state(graphics.STATE_CULL_FACE) end
            render.draw(self.casters[category],{constants=self.shadow_constants,frustum=light_proj*light_view})
        end
        render.disable_material()
        render.disable_state(graphics.STATE_POLYGON_OFFSET_FILL)
        render.disable_state(graphics.STATE_CULL_FACE)
        self.shadow_valid=true
    end

    -- Small stable near cascade. Filter moments once, rather than dozens of
    -- shadow comparisons per full-resolution receiver pixel.
    local focus=self.shadow_focus
    local near_center=focus-sun*(focus.y/sun.y)
    local near_texel=24/512
    local nx=vmath.dot(near_center,right);local ny=vmath.dot(near_center,up)
    near_center=near_center+right*(math.floor(nx/near_texel+.5)*near_texel-nx)+up*(math.floor(ny/near_texel+.5)*near_texel-ny)
    local near_view=vmath.matrix4_look_at(near_center+sun*120,near_center,vmath.vector3(0,0,1))
    local near_proj=vmath.matrix4_orthographic(-12,12,-12,12,1,240)
    self.constants.near_light_matrix=near_proj*near_view
    local near_caster_frustum=vmath.matrix4_orthographic(-14,14,-14,14,1,240)*near_view
    render.set_render_target(self.near_shadow)
    render.set_viewport(0,0,512,512)
    render.clear({[graphics.BUFFER_TYPE_COLOR0_BIT]=vmath.vector4(1,1,0,0),[graphics.BUFFER_TYPE_DEPTH_BIT]=1})
    render.set_view(near_view)
    render.set_projection(near_proj)
    render.enable_material("shadow_moments")
    for _,category in ipairs({0,1,2,3,6,8}) do
        if category==0 or category==8 then
            render.enable_state(graphics.STATE_CULL_FACE)
            render.set_cull_face(category==0 and graphics.FACE_TYPE_FRONT or graphics.FACE_TYPE_BACK)
        else render.disable_state(graphics.STATE_CULL_FACE) end
        if (category~=1 and category~=2 and category~=3 and category~=6) or self.constants.visual_debug.y<.5 then
            render.enable_material((category==1 or category==2 or category==3 or category==6) and "shadow_moments_skinned" or "shadow_moments")
            render.draw(self.casters[category],{constants=self.shadow_constants,frustum=near_caster_frustum})
        end
    end
    render.disable_material()
    render.disable_state(graphics.STATE_CULL_FACE)
    render.disable_state(graphics.STATE_DEPTH_TEST)
    render.set_depth_mask(false)
    render.enable_material("shadow_blur")
    render.set_render_target(self.near_ping)
    render.enable_texture("moments",self.near_shadow,graphics.BUFFER_TYPE_COLOR0_BIT)
    self.blur_constants.blur_direction=vmath.vector4(1/512,0,0,0)
    render.draw(self.blit,{constants=self.blur_constants})
    render.disable_texture("moments")
    render.set_render_target(self.near_shadow)
    render.enable_texture("moments",self.near_ping,graphics.BUFFER_TYPE_COLOR0_BIT)
    self.blur_constants.blur_direction=vmath.vector4(0,1/512,0,0)
    render.draw(self.blit,{constants=self.blur_constants})
    render.disable_texture("moments")
    render.disable_material()

    render.set_depth_mask(true)
    render.set_render_target(self.target)
    render.clear({[graphics.BUFFER_TYPE_COLOR0_BIT]=vmath.vector4(0.062500,0.625000,0.945500,1),[graphics.BUFFER_TYPE_DEPTH_BIT]=1})
    render.set_viewport(0,0,rw,rh)
    render.set_view(self.view)
    local projection=vmath.matrix4_perspective(math.rad(59),w/h,.15,400)
    render.set_projection(projection)
    self.constants.inverse_view_projection=vmath.inv(projection*self.view)
    render.set_depth_mask(false)
    render.disable_state(graphics.STATE_DEPTH_TEST)
    render.enable_material("background")
    render.draw(self.blit,{constants=self.constants})
    render.disable_material()
    render.set_depth_mask(true)
    render.enable_state(graphics.STATE_DEPTH_TEST)
    render.enable_texture("sun_depth",self.shadow,graphics.BUFFER_TYPE_DEPTH_BIT)
    render.enable_texture("near_shadow",self.near_shadow,graphics.BUFFER_TYPE_COLOR0_BIT)
    if self.constants.visual_debug.x>9.5 and self.constants.visual_debug.x<11.5 then
        -- Compare visible and shadow vertex paths for plants, fish and rays.
        if self.constants.visual_debug.x>10.5 then render.enable_material("shadow") end
        for _,category in ipairs({1,2,3,6}) do
            if self.constants.visual_debug.x>10.5 then render.enable_material("shadow_skinned") end
            render.draw(self.casters[category],{constants=self.constants,frustum=projection*self.view})
        end
        if self.constants.visual_debug.x>10.5 then render.disable_material() end
    else
        render.enable_state(graphics.STATE_CULL_FACE)
        render.set_cull_face(graphics.FACE_TYPE_BACK)
        render.draw(self.solid,{constants=self.constants,frustum=projection*self.view})
        render.disable_state(graphics.STATE_CULL_FACE)
        render.draw(self.thin,{constants=self.constants,frustum=projection*self.view})
    end
    render.disable_texture("near_shadow")
    render.set_depth_mask(false)
    render.enable_state(graphics.STATE_BLEND)
    render.set_blend_func(graphics.BLEND_FACTOR_ONE,graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.enable_state(graphics.STATE_CULL_FACE)
    render.set_cull_face(graphics.FACE_TYPE_BACK)
    if self.constants.visual_debug.x<9.5 then render.draw(self.bubbles,{constants=self.constants,frustum=projection*self.view}) end
    render.disable_state(graphics.STATE_CULL_FACE)
    render.disable_state(graphics.STATE_BLEND)
    render.disable_state(graphics.STATE_DEPTH_TEST)
    self.constants.inverse_view_projection=vmath.inv(projection*self.view)
    self.constants.screen_size=vmath.vector4(rw,rh,math.ceil(rw/4),math.ceil(rh/4))
    if self.scene_depth~=self.target then
        render.set_render_target(self.scene_depth)
        render.set_viewport(0,0,rw,rh)
        render.set_depth_mask(true)
        render.clear({[graphics.BUFFER_TYPE_DEPTH_BIT]=1})
        render.set_color_mask(false,false,false,false)
        render.enable_state(graphics.STATE_DEPTH_TEST)
        render.enable_material("scene_depth")
        render.enable_state(graphics.STATE_CULL_FACE)
        render.set_cull_face(graphics.FACE_TYPE_BACK)
        render.disable_state(graphics.STATE_CULL_FACE)
        render.draw(self.rigid,{frustum=projection*self.view})
        render.enable_material("scene_depth_skinned")
        render.draw(self.skinned,{frustum=projection*self.view})
        render.disable_material()
        render.disable_state(graphics.STATE_DEPTH_TEST)
        render.set_depth_mask(false)
        render.set_color_mask(true,true,true,true)
    end
    render.set_render_target(self.water)
    render.set_viewport(0,0,math.ceil(rw/4),math.ceil(rh/4))
    render.enable_texture("scene_depth",self.scene_depth,graphics.BUFFER_TYPE_DEPTH_BIT)
    if self.solar_flux then render.enable_texture("solar_flux",self.solar_flux) end
    render.enable_material("volume")
    render.draw(self.blit,{constants=self.constants})
    render.disable_material()
    if self.solar_flux then render.disable_texture("solar_flux") end
    render.set_render_target(self.composite)
    render.set_viewport(0,0,rw,rh)
    render.enable_texture("scene_texture",self.target,graphics.BUFFER_TYPE_COLOR0_BIT)
    render.enable_texture("water_texture",self.water,graphics.BUFFER_TYPE_COLOR0_BIT)
    render.draw(self.blit,{constants=self.constants})
    render.disable_texture("water_texture")
    render.disable_texture("scene_texture")
    render.disable_texture("scene_depth")
    render.disable_texture("sun_depth")
    -- Post-process at the same resolution as geometry, then upscale only once.
    render.set_render_target(render.RENDER_TARGET_DEFAULT)
    render.set_viewport(0,0,w,h)
    render.enable_texture("scene_texture",self.composite,graphics.BUFFER_TYPE_COLOR0_BIT)
    render.enable_material("present")
    render.draw(self.blit,{constants=self.constants})
    render.disable_material()
    render.disable_texture("scene_texture")

end

function on_reload(self)
    self.shadow_valid=false
end

function on_message(self,id,message)
    if id==hash("shadow_dirty") then self.shadow_valid=false end
    if id==hash("solar_flux") then self.solar_flux=message.texture end
    if id==hash("lighting_debug") then self.constants.visual_debug=vmath.vector4(message.mode,message.static_only and 1 or 0,0,0) end
    if id==hash("scene_camera") then
        self.view=message.view
        self.constants.camera_pos=message.position
        self.constants.time_data=message.time_data
        self.shadow_focus=message.shadow_focus or self.shadow_focus
    end
end
