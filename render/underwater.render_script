local function target(w,h,depth_texture)
    return render.render_target({
        [graphics.BUFFER_TYPE_COLOR0_BIT]={format=graphics.TEXTURE_FORMAT_RGBA,width=w,height=h,min_filter=graphics.TEXTURE_FILTER_LINEAR,mag_filter=graphics.TEXTURE_FILTER_LINEAR,u_wrap=graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,v_wrap=graphics.TEXTURE_WRAP_CLAMP_TO_EDGE},
        [graphics.BUFFER_TYPE_DEPTH_BIT]={format=graphics.TEXTURE_FORMAT_DEPTH,width=w,height=h,flags=depth_texture and render.TEXTURE_BIT or 0,min_filter=graphics.TEXTURE_FILTER_NEAREST,mag_filter=graphics.TEXTURE_FILTER_NEAREST,u_wrap=graphics.TEXTURE_WRAP_CLAMP_TO_EDGE,v_wrap=graphics.TEXTURE_WRAP_CLAMP_TO_EDGE}
    })
end

function init(self)
    self.solid=render.predicate({"reefsolid"})
    self.thin=render.predicate({"reefthin"})
    self.casters={}
    for _,category in ipairs({0,1,2,3,6}) do self.casters[category]=render.predicate({"caster"..category}) end
    self.shadow_constants=render.constant_buffer()
    self.text=render.predicate({"text"})
    self.blit=render.predicate({"blit"})
    self.view=vmath.matrix4_look_at(vmath.vector3(0,7,13),vmath.vector3(0,6,-13),vmath.vector3(0,1,0))
    self.constants=render.constant_buffer()
    self.constants.visual_debug=vmath.vector4()
    self.constants.time_data=vmath.vector4(3,0,0,0)
    self.constants.camera_pos=vmath.vector4(0,7,13,1)
    self.constants.fog_settings=vmath.vector4(0.062500,0.625000,0.945500,.016)
    self.shadow=target(1024,1024,true)
end

function update(self)
    local w,h=render.get_window_width(),render.get_window_height()
    if w==0 or h==0 then return end
    local scale=math.min(1,1280/w,720/h)
    local rw,rh=math.floor(w*scale),math.floor(h*scale)
    if not self.target then
        self.target=target(rw,rh,true)
        self.composite=target(rw,rh,false)
        self.rw,self.rh=rw,rh
        self.water=target(math.ceil(rw/4),math.ceil(rh/4),false)
    elseif rw~=self.rw or rh~=self.rh then
        render.set_render_target_size(self.target,rw,rh)
        render.set_render_target_size(self.composite,rw,rh)
        render.set_render_target_size(self.water,math.ceil(rw/4),math.ceil(rh/4))
        self.rw,self.rh=rw,rh
    end
    local camera=self.constants.camera_pos
    local sun=vmath.normalize(vmath.vector3(.35,.90,-.24))
    local right=vmath.normalize(vmath.cross(-sun,vmath.vector3(0,0,1)))
    local up=vmath.normalize(vmath.cross(right,-sun))
    local desired=vmath.vector3(camera.x,0,camera.z-25)
    local texel=100/1024
    local x=vmath.dot(desired,right);local y=vmath.dot(desired,up)
    local center=desired+right*(math.floor(x/texel+.5)*texel-x)+up*(math.floor(y/texel+.5)*texel-y)
    local light_view=vmath.matrix4_look_at(center+sun*80,center,vmath.vector3(0,0,1))
    local light_proj=vmath.matrix4_orthographic(-50,50,-50,50,1,150)
    self.constants.light_matrix=light_proj*light_view
    render.set_depth_mask(true)
    render.enable_state(graphics.STATE_DEPTH_TEST)
    render.disable_state(graphics.STATE_CULL_FACE)
    render.disable_state(graphics.STATE_BLEND)
    render.set_render_target(self.shadow)
    render.set_viewport(0,0,1024,1024)
    render.clear({[graphics.BUFFER_TYPE_COLOR0_BIT]=vmath.vector4(1),[graphics.BUFFER_TYPE_DEPTH_BIT]=1})
    render.set_view(light_view)
    render.set_projection(light_proj)
    render.enable_material("shadow")
    self.shadow_constants.time_data=self.constants.time_data
    for _,category in ipairs({0,1,2,3,6}) do
        self.shadow_constants.params=vmath.vector4(category,0,0,0)
        if category==0 then
            render.enable_state(graphics.STATE_CULL_FACE)
            render.set_cull_face(graphics.FACE_TYPE_FRONT)
        else render.disable_state(graphics.STATE_CULL_FACE) end
        render.draw(self.casters[category],{constants=self.shadow_constants,frustum=self.constants.light_matrix})
    end
    render.disable_material()
    render.disable_state(graphics.STATE_CULL_FACE)

    render.set_render_target(self.target)
    render.clear({[graphics.BUFFER_TYPE_COLOR0_BIT]=vmath.vector4(0.062500,0.625000,0.945500,1),[graphics.BUFFER_TYPE_DEPTH_BIT]=1})
    render.set_viewport(0,0,rw,rh)
    render.set_view(self.view)
    local projection=vmath.matrix4_perspective(math.rad(59),w/h,.15,400)
    render.set_projection(projection)
    self.constants.inverse_view_projection=vmath.inv(projection*self.view)
    render.set_depth_mask(false)
    render.disable_state(graphics.STATE_DEPTH_TEST)
    render.enable_material("background")
    render.draw(self.blit,{constants=self.constants})
    render.disable_material()
    render.set_depth_mask(true)
    render.enable_state(graphics.STATE_DEPTH_TEST)
    render.enable_texture("sun_depth",self.shadow,graphics.BUFFER_TYPE_DEPTH_BIT)
    render.enable_state(graphics.STATE_CULL_FACE)
    render.set_cull_face(graphics.FACE_TYPE_BACK)
    render.draw(self.solid,{constants=self.constants,frustum=projection*self.view})
    render.disable_state(graphics.STATE_CULL_FACE)
    render.draw(self.thin,{constants=self.constants,frustum=projection*self.view})
    render.set_depth_mask(false)
    render.disable_state(graphics.STATE_DEPTH_TEST)
    self.constants.inverse_view_projection=vmath.inv(projection*self.view)
    self.constants.screen_size=vmath.vector4(rw,rh,math.ceil(rw/4),math.ceil(rh/4))
    render.set_render_target(self.water)
    render.set_viewport(0,0,math.ceil(rw/4),math.ceil(rh/4))
    render.enable_texture("scene_depth",self.target,graphics.BUFFER_TYPE_DEPTH_BIT)
    render.enable_material("volume")
    render.draw(self.blit,{constants=self.constants})
    render.disable_material()
    render.set_render_target(self.composite)
    render.set_viewport(0,0,rw,rh)
    render.enable_texture("scene_texture",self.target,graphics.BUFFER_TYPE_COLOR0_BIT)
    render.enable_texture("water_texture",self.water,graphics.BUFFER_TYPE_COLOR0_BIT)
    render.draw(self.blit,{constants=self.constants})
    render.disable_texture("water_texture")
    render.disable_texture("scene_texture")
    render.disable_texture("scene_depth")
    render.disable_texture("sun_depth")
    -- Post-process at the same resolution as geometry, then upscale only once.
    render.set_render_target(render.RENDER_TARGET_DEFAULT)
    render.set_viewport(0,0,w,h)
    render.enable_texture("scene_texture",self.composite,graphics.BUFFER_TYPE_COLOR0_BIT)
    render.enable_material("present")
    render.draw(self.blit)
    render.disable_material()
    render.disable_texture("scene_texture")
    render.enable_state(graphics.STATE_BLEND)
    render.set_blend_func(graphics.BLEND_FACTOR_ONE,graphics.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA)
    render.set_view(vmath.matrix4())
    render.set_projection(vmath.matrix4_orthographic(0,1280,0,720,-1,1))
    render.draw(self.text)
end

function on_message(self,id,message)
    if id==hash("lighting_debug") then self.constants.visual_debug=vmath.vector4(message.mode,0,0,0) end
    if id==hash("scene_camera") then
        self.view=message.view
        self.constants.camera_pos=message.position
        self.constants.time_data=message.time_data
    end
end
